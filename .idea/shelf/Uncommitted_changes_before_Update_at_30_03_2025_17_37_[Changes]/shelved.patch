<+>@import url(\"../../colors.css\");\r\n\r\n/* ===== VARIABLES CSS ===== */\r\n:root {\r\n  --header-height: 70px;\r\n  --transition-speed: 0.3s;\r\n  --border-radius: 10px;\r\n  --hover-brightness: 1.2;\r\n  --element-spacing: 1.5rem;\r\n  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.15);\r\n  --border-light: 1px solid rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n/* ===== RESET Y ESTILOS BASE ===== */\r\nbody, html {\r\n  margin: 0;\r\n  padding: 0;\r\n  font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;\r\n}\r\n\r\n/* ===== HEADER PRINCIPAL ===== */\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  background-color: var(--verde-primario);\r\n  padding: 0 5%;\r\n  height: var(--header-height);\r\n  border-bottom: var(--border-light);\r\n  box-shadow: var(--shadow-sm);\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1000;\r\n  backdrop-filter: blur(5px);\r\n  -webkit-backdrop-filter: blur(5px);\r\n}\r\n\r\n/* ===== LOGO ===== */\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n  transition: all var(--transition-speed) cubic-bezier(0.25, 0.1, 0.25, 1);\r\n  height: 100%;\r\n}\r\n\r\n.logo-container:hover {\r\n  transform: translateY(-2px);\r\n}\r\n\r\n#Main_Icon {\r\n  height: 40px;\r\n  width: auto;\r\n  object-fit: contain;\r\n  transition: all var(--transition-speed) ease;\r\n  filter: drop-shadow(var(--shadow-sm));\r\n}\r\n\r\n.logo-container:hover #Main_Icon {\r\n  transform: scale(1.05);\r\n  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.15));\r\n}\r\n\r\n/* ===== SECCIÓN DE USUARIO ===== */\r\n.user-section-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: var(--element-spacing);\r\n  height: 100%;\r\n}\r\n\r\n/* ===== BOTONES ===== */\r\n.button-header-login {\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 8px 10px;\r\n  border-radius: var(--border-radius);\r\n  transition: all var(--transition-speed) ease;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.button-header-login:hover {\r\n  background-color: rgba(255, 255, 255, 0.1);\r\n}\r\n\r\n.button-header-login::before {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 2px;\r\n  background-color: var(--coral);\r\n  transform: scaleX(0);\r\n  transform-origin: right;\r\n  transition: transform var(--transition-speed) ease;\r\n}\r\n\r\n.button-header-login:hover::before {\r\n  transform: scaleX(1);\r\n  transform-origin: left;\r\n}\r\n\r\n#Inicio, #Configuracion {\r\n  width: 24px;\r\n  height: 24px;\r\n  filter: brightness(0.9);\r\n  transition: all var(--transition-speed) ease;\r\n  object-fit: contain;\r\n}\r\n\r\n.button-header-login:hover #Inicio,\r\n.button-header-login:hover #Configuracion {\r\n  transform: scale(1.15) rotate(5deg);\r\n  filter: brightness(var(--hover-brightness));\r\n}\r\n\r\n/* ===== NOMBRE DE USUARIO ===== */\r\n.username {\r\n  font-size: 0.95rem;\r\n  color: var(--black);\r\n  font-weight: 600;\r\n  letter-spacing: 0.3px;\r\n  text-transform: capitalize;\r\n  transition: all var(--transition-speed) ease;\r\n  position: relative;\r\n  padding: 6px 12px;\r\n  border-radius: var(--border-radius);\r\n  background: rgba(255, 255, 255, 0.05);\r\n}\r\n\r\n.username:hover {\r\n  color: var(--coral);\r\n  background: rgba(255, 255, 255, 0.15);\r\n  transform: translateY(-2px);\r\n}\r\n\r\n/* ===== AVATAR ===== */\r\n.avatar-container {\r\n  display: flex;\r\n  align-items: center;\r\n  transition: all var(--transition-speed) ease;\r\n}\r\n\r\n#avatarPng {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n  border: 2px solid rgba(255, 255, 255, 0.4);\r\n  transition: all var(--transition-speed) ease;\r\n  box-shadow: var(--shadow-sm);\r\n}\r\n\r\n.avatar-container:hover #avatarPng {\r\n  transform: scale(1.1);\r\n  border-color: rgba(255, 255, 255, 0.8);\r\n  box-shadow: var(--shadow-md);\r\n}\r\n\r\n/* ===== EFECTOS DE INTERACCIÓN ===== */\r\n.button-header-login:active,\r\n.avatar-container:active {\r\n  transform: scale(0.95);\r\n}\r\n\r\n/* ===== DISEÑO RESPONSIVE ===== */\r\n@media (max-width: 992px) {\r\n  :root {\r\n    --element-spacing: 1.2rem;\r\n    --header-height: 65px;\r\n  }\r\n\r\n  #Main_Icon {\r\n    height: 36px;\r\n  }\r\n\r\n  #avatarPng {\r\n    width: 36px;\r\n    height: 36px;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  :root {\r\n    --element-spacing: 1rem;\r\n    --header-height: 60px;\r\n  }\r\n\r\n  .header {\r\n    padding: 0 4%;\r\n  }\r\n\r\n  #Inicio, #Configuracion {\r\n    width: 22px;\r\n    height: 22px;\r\n  }\r\n\r\n  .username {\r\n    font-size: 0.9rem;\r\n    padding: 5px 10px;\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  :root {\r\n    --element-spacing: 0.8rem;\r\n  }\r\n\r\n  .username {\r\n    display: none;\r\n  }\r\n\r\n  #Main_Icon {\r\n    height: 32px;\r\n  }\r\n\r\n  #avatarPng {\r\n    width: 34px;\r\n    height: 34px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .header {\r\n    padding: 0 3%;\r\n  }\r\n\r\n  #Inicio, #Configuracion {\r\n    width: 20px;\r\n    height: 20px;\r\n  }\r\n\r\n  #avatarPng {\r\n    width: 32px;\r\n    height: 32px;\r\n  }\r\n}\r\n
