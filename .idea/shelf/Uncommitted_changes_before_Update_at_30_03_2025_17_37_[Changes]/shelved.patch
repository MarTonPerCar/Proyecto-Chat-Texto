<+>:root {\r\n  --primary-color: #4361ee;\r\n  --secondary-color: #3a0ca3;\r\n  --text-color: #2b2d42;\r\n  --light-color: #f8f9fa;\r\n  --border-radius: 12px;\r\n  --shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n  --shadow-hover: 0 4px 12px rgba(0, 0, 0, 0.15);\r\n  --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);\r\n}\r\n\r\n/* Contenedor específico para evitar colisiones */\r\n#avatarPerfil {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 1rem;\r\n  padding: 1rem 1.5rem;\r\n  background-color: white;\r\n  border-radius: var(--border-radius);\r\n  box-shadow: var(--shadow);\r\n  transition: var(--transition);\r\n  max-width: 300px;\r\n  width: 100%;\r\n  margin: 1rem auto; /* Centrado con margen */\r\n  position: relative;\r\n  z-index: 10; /* Nivel por encima del contenido normal */\r\n}\r\n\r\n#avatarPerfil:hover {\r\n  transform: translateY(-3px);\r\n  box-shadow: var(--shadow-hover);\r\n}\r\n\r\n/* Avatar circular - selector más específico */\r\n#avatarPerfil .circular-img {\r\n  width: 60px;\r\n  height: 60px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n  border: 2px solid white;\r\n  box-shadow: var(--shadow);\r\n  transition: var(--transition);\r\n  flex-shrink: 0;\r\n}\r\n\r\n#avatarPerfil:hover .circular-img {\r\n  transform: scale(1.05);\r\n  border-color: var(--primary-color);\r\n}\r\n\r\n/* Nombre de usuario - selector específico */\r\n#avatarPerfil #username {\r\n  font-size: 1rem;\r\n  font-weight: 600;\r\n  color: var(--text-color);\r\n  transition: var(--transition);\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 180px;\r\n}\r\n\r\n#avatarPerfil:hover #username {\r\n  color: var(--primary-color);\r\n}\r\n\r\n/* Estado activo */\r\n#avatarPerfil.active .circular-img {\r\n  border-color: var(--primary-color);\r\n  box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.2);\r\n}\r\n\r\n/* Efecto de carga */\r\n.circular-img.loading {\r\n  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);\r\n  background-size: 200% 100%;\r\n  animation: loading 1.5s infinite;\r\n}\r\n\r\n@keyframes loading {\r\n  0% { background-position: 200% 0; }\r\n  100% { background-position: -200% 0; }\r\n}\r\n\r\n/* Responsive */\r\n@media (max-width: 480px) {\r\n  #avatarPerfil {\r\n    padding: 0.75rem 1rem;\r\n    gap: 0.75rem;\r\n  }\r\n\r\n  #avatarPerfil .circular-img {\r\n    width: 50px;\r\n    height: 50px;\r\n  }\r\n\r\n  #avatarPerfil #username {\r\n    font-size: 0.9rem;\r\n    max-width: 150px;\r\n  }\r\n}\r\n
