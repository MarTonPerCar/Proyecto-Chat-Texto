<+>/* Ajustar el body para que el footer no esté pegado */\r\nbody {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n  background-color: #3ec9a7;\r\n}\r\n\r\n/* Permitir que el contenedor principal crezca */\r\n.container {\r\n  display: flex;\r\n  flex: 1;\r\n  width: 100%;\r\n  min-height: 85vh; /* Aumentamos la altura para hacer espacio */\r\n  background: gray;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Ajustar la altura del chat para que ocupe más */\r\n.chat-container {\r\n  width: 60%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 75vh; /* Aumentamos la altura del chat */\r\n}\r\n\r\n\r\nhtml:has(#content-special) footer {\r\n  position: relative !important;\r\n}\r\n\r\n/* ------------------- */\r\n/* BARRA LATERAL */\r\n/* ------------------- */\r\n#sidebar {\r\n  width: 30%;\r\n  background: white;\r\n  border-right: 1px solid #ddd;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n#chat-header {\r\n  display: flex;\r\n  justify-content: center; /* Centra el texto horizontalmente */\r\n  align-items: center; /* Centra verticalmente */\r\n  text-align: center;\r\n  font-weight: bold;\r\n  padding: 15px;\r\n  background: black;\r\n  color: white;\r\n}\r\n\r\n/* ------------------- */\r\n/* LISTA DE CONVERSACIONES */\r\n/* ------------------- */\r\n/* Estilo de la barra lateral */\r\n#sidebar {\r\n  width: 30%;\r\n  background: white;\r\n  border-right: 1px solid #ddd;\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 0;\r\n}\r\n\r\n/* Cabecera de la barra lateral */\r\n#chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between; /* Alinear a la izquierda */\r\n  padding: 15px;\r\n  background: black;\r\n  color: white;\r\n  font-weight: bold;\r\n}\r\n\r\n/* Contenedor de los botones */\r\n.chat-buttons {\r\n  display: flex;\r\n  justify-content: right;\r\n  gap: 8px; /* Espacio entre botones */\r\n}\r\n\r\n/* Estilos de los botones */\r\n.icon-button {\r\n  background: white;\r\n\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 5px;\r\n  border-radius: 5px;\r\n  transition: background 0.2s ease-in-out;\r\n}\r\n\r\n.icon-button img {\r\n  width: 24px; /* Ajusta el tamaño del icono */\r\n  height: 24px;\r\n}\r\n\r\n/* Efecto hover */\r\n.icon-button:hover {\r\n  background: rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n/* Contenedor de la lista de chats */\r\n.chat-list {\r\n  flex-grow: 1;\r\n  overflow-y: auto;\r\n  width: 100%; /* Ocupar todo el ancho */\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  padding: 10px;\r\n}\r\n\r\n/* Cada conversación ocupará **TODO** el espacio disponible */\r\n.conversation {\r\n  width: 100%; /* Ocupar todo el ancho */\r\n  background: white;\r\n  transition: background 0.2s ease-in-out;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* Avatar dentro de cada chat */\r\n.conversation img {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n  margin-right: 15px;\r\n}\r\n\r\n/* Ajuste del contenido del chat */\r\n.chat-info {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex-grow: 1; /* Permite que el texto ocupe todo el espacio disponible */\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* Estilos de texto en el chat */\r\n.chat-info p {\r\n  margin: 0;\r\n  font-size: 14px;\r\n}\r\n\r\n.chat-info p strong {\r\n  font-size: 16px;\r\n}\r\n\r\n/* Efecto hover */\r\n.conversation:hover {\r\n  background: #f0f0f0;\r\n}\r\n\r\n/* ------------------- */\r\n/* ÁREA DEL CHAT */\r\n/* ------------------- */\r\n.chat-container {\r\n  width: 70%;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n/* Espacio para el avatar y el nombre */\r\n.user-info-template {\r\n  display: flex;\r\n  align-items: center;\r\n  height: 60px; /* Espacio adecuado */\r\n  background: black;\r\n  padding: 10px;\r\n  color: white;\r\n}\r\n\r\n#avatar {\r\n  display: flex;\r\n  align-items: center; /* Alinea en una misma línea */\r\n  gap: 8px; /* Espaciado entre imagen y texto */\r\n}\r\n\r\n#avatar img {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 50%;\r\n}\r\n\r\n#avatar p {\r\n  font-size: 14px;\r\n  color: white;\r\n  margin: 0;\r\n  padding: 0;\r\n  white-space: nowrap;\r\n}\r\n\r\n\r\n.chat-messages {\r\n  flex-grow: 1;\r\n  padding: 15px;\r\n  background: gray;\r\n  overflow-y: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  max-height: calc(100vh - 200px);\r\n}\r\n\r\n/* Ajustar mensajes dentro del chat */\r\n.messages {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: 100%;\r\n  max-height: 100%;\r\n  overflow-y: auto;\r\n  padding: 10px;\r\n}\r\n\r\n/* Cada mensaje ocupa su espacio correctamente */\r\n.message {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 6px;\r\n  margin-bottom: 10px;\r\n  border-radius: 8px;\r\n  word-wrap: break-word;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Forzar que los mensajes respeten su propio diseño */\r\n.message.received {\r\n  background: white;\r\n  align-self: flex-start;\r\n  box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.message.received time {\r\n  align-self: flex-end;\r\n}\r\n\r\n.message.sent {\r\n  background: lawngreen;\r\n  align-self: flex-end;\r\n  box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n/* ------------------- */\r\n/* BARRA DE MENSAJES */\r\n/* ------------------- */\r\n.chat-input {\r\n  display: flex;\r\n  padding: 10px;\r\n  background: black;\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.chat-input input {\r\n  flex: 1;\r\n  padding: 10px;\r\n  font-size: 14px;\r\n  border: none;\r\n  border-radius: 5px;\r\n}\r\n\r\n.chat-input button {\r\n  background: lightslategrey;\r\n  color: black;\r\n  border: none;\r\n  padding: 10px 15px;\r\n  cursor: pointer;\r\n  border-radius: 5px;\r\n}\r\n\r\n.chat-input button:hover {\r\n  background: darkgrey;\r\n}\r\n\r\n.emoji-btn, .attach-btn {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  font-size: 20px;\r\n  cursor: pointer;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  transition: background 0.3s ease, transform 0.1s ease;\r\n}\r\n\r\n.emoji-btn:hover, .attach-btn:hover {\r\n  transform: scale(1.1);\r\n}\r\n
