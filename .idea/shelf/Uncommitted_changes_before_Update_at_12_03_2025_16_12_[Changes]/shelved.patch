<+>* {\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\nbody {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh; /* Al menos la altura completa de la pantalla */\r\n  height: 100%;\r\n  margin: 0;\r\n  padding: 0;\r\n  background-color: #3ec9a7;\r\n}\r\n\r\n#header {\r\n  margin-bottom: 20px; /* Espaciado con el main */\r\n}\r\n\r\n#footer {\r\n  margin-top: 20px; /* Espaciado con el main */\r\n}\r\n\r\nmain {\r\n  flex: 1; /* Hace que el main crezca y empuje el footer abajo */\r\n  padding: 20px;\r\n}\r\n\r\n.form-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center; /* Centra todo dentro del formulario */\r\n  justify-content: center;\r\n  width: 100%;\r\n}\r\n\r\n#input-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center; /* Centra los elementos */\r\n  gap: 10px;\r\n  width: 50vw; /* Mismo ancho que los inputs */\r\n}\r\n\r\n.form-container form div {\r\n  width: 100%; /* Asegura que los elementos dentro del form ocupen todo */\r\n}\r\n\r\n.texto-container {\r\n  display: flex;\r\n  justify-content: center; /* Centrar el botón */\r\n  margin-top: 20px; /* Espaciado superior */\r\n}\r\n\r\n.boton-container {\r\n  display: flex;\r\n  justify-content: center; /* Centrar el botón */\r\n  margin-top: 20px; /* Espaciado superior */\r\n}\r\n\r\n.boton-container a {\r\n  text-decoration: none; /* Quita el subrayado del enlace */\r\n}\r\n\r\n.boton-container button {\r\n  height: 3vh; /* Misma altura que el input */\r\n  width: 50vw; /* Misma anchura que el input */\r\n  border: 1px solid #333333; /* Mismo borde que el input */\r\n  border-radius: 5px; /* Bordes redondeados */\r\n  background-color: #333333; /* Color de fondo similar al input */\r\n  color: white; /* Color del texto */\r\n  font-size: 16px; /* Tamaño de letra */\r\n  cursor: pointer;\r\n  transition: background 0.3s ease-in-out;\r\n}\r\n\r\n.boton-container button:hover {\r\n  background-color: #25D366; /* Cambio de color al pasar el mouse */\r\n}\r\n\r\n\r\n\r\n
